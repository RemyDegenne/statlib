module

public import Statlib.Divergence.FDiv.Trim
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.LebesgueBochner
public import Mathlib.Probability.Martingale.Convergence
public import Statlib.ForMathlib.Probability.Process.PartitionFiltration

/-!
# Approximation of f-divergences by finite sub-σ-algebras

The f-divergence between two finite measures is the supremum of the f-divergences between their
restrictions to finite sub-σ-algebras, and it is the limit of the f-divergences between their
restrictions to the σ-algebras of a filtration which generates the σ-algebra.

## Main statements

* `tendsto_fDiv_trim_iSup`: along a filtration `ℱ`, the f-divergences between the restrictions to
  `ℱ n` converge to the f-divergence between the restrictions to `⨆ n, ℱ n`.
* `tendsto_fDiv_trim_of_iSup_eq`: the same when the filtration generates the σ-algebra, in which
  case the limit is `fDiv f μ ν`.
* `tendsto_fDiv_map_of_iSup_comap_eq`: the same for the pushforwards by a sequence of maps.
* `exists_tendsto_fDiv_trim`: there is a filtration by finite sub-σ-algebras, independent of `f`,
  along which the f-divergences of the restrictions converge to `fDiv f μ ν`.
* `fDiv_eq_iSup_fDiv_trim`: `fDiv f μ ν` is the supremum over finite sub-σ-algebras `m` of
  `fDiv f (μ.trim hm) (ν.trim hm)`.

## Implementation details

We write the f-divergences of the restrictions as integrals of `f.mixtureFun` composed with the
conditional expectations of `∂μ/∂(μ + ν)` (`fDiv_trim_eq_lintegral_mixtureFun_condLExp`). This
accounts for the singular part of `μ` with respect to `ν` without any absolute continuity
hypothesis. For the filtration results, the conditional expectations of `∂μ/∂(μ + ν)` converge by
Lévy's upward theorem `MeasureTheory.tendsto_ae_condExp`, the function `f.mixtureFun` is continuous
(`DivFunction.continuous_mixtureFun`), and Fatou's lemma concludes. For the finite
sub-σ-algebras, we use the filtration `countableFiltration` of the countably generated σ-algebra
generated by `∂μ/∂(μ + ν)`.
-/

@[expose] public section

open Real MeasureTheory Filter Set

open scoped ENNReal NNReal Topology

namespace ProbabilityTheory

variable {α : Type*} {m mα : MeasurableSpace α} {μ ν : Measure α} {f : DivFunction}

section Filtration

/-- **Approximation along a filtration**: the f-divergences between the restrictions of `μ` and
`ν` to the σ-algebras of a filtration `ℱ` converge to the f-divergence between their restrictions to
`⨆ n, ℱ n`. -/
theorem tendsto_fDiv_trim_iSup [IsFiniteMeasure μ] [IsFiniteMeasure ν] (ℱ : Filtration ℕ mα) :
    Tendsto (fun n ↦ fDiv f (μ.trim (ℱ.le n)) (ν.trim (ℱ.le n))) atTop
      (𝓝 (fDiv f (μ.trim (iSup_le ℱ.le)) (ν.trim (iSup_le ℱ.le)))) := by
  set p := ∂μ/∂(μ + ν)
  have h_int : ∫⁻ x, p x ∂(μ + ν) ≠ ∞ := by
    rw [Measure.lintegral_rnDeriv (Measure.AbsolutelyContinuous.rfl.add_right ν)]
    exact measure_ne_top _ _
  -- Lévy's upward theorem for the conditional expectations of `p`
  have h_tendsto : ∀ᵐ x ∂(μ + ν),
      Tendsto (fun n ↦ (μ + ν)⁻[p | ℱ n] x) atTop (𝓝 ((μ + ν)⁻[p | ⨆ n, ℱ n] x)) := by
    filter_upwards [tendsto_ae_condExp (μ := μ + ν) (ℱ := ℱ) fun x ↦ (p x).toReal,
      ae_all_iff.2 fun n ↦ toReal_condLExp (ℱ n) (by fun_prop) h_int,
      toReal_condLExp (⨆ n, ℱ n) (by fun_prop) h_int,
      ae_all_iff.2 fun n ↦ condLExp_ne_top (mΩ := ℱ n) h_int,
      condLExp_ne_top (mΩ := ⨆ n, ℱ n) h_int] with x hx h_eq h_eq' hx_top hx_top'
    rw [← ENNReal.tendsto_toReal_iff hx_top hx_top']
    simpa only [h_eq, h_eq'] using hx
  -- the lower bound follows from Fatou's lemma, the upper bound from the data processing inequality
  have h_dpi (n : ℕ) : fDiv f (μ.trim (ℱ.le n)) (ν.trim (ℱ.le n))
      ≤ fDiv f (μ.trim (iSup_le ℱ.le)) (ν.trim (iSup_le ℱ.le)) := by
    have h := fDiv_trim_le (f := f) (μ := μ.trim (iSup_le ℱ.le)) (ν := ν.trim (iSup_le ℱ.le))
      (le_iSup (fun n ↦ ℱ n) n)
    rwa [trim_trim, trim_trim] at h
  refine tendsto_of_le_liminf_of_limsup_le ?_
    (limsup_le_of_le (by isBoundedDefault) (Eventually.of_forall h_dpi))
  simp_rw [fDiv_trim_eq_lintegral_mixtureFun_condLExp]
  calc ∫⁻ x, f.mixtureFun ((μ + ν)⁻[p | ⨆ n, ℱ n] x) ∂(μ + ν)
      = ∫⁻ x, liminf (fun n ↦ f.mixtureFun ((μ + ν)⁻[p | ℱ n] x)) atTop ∂(μ + ν) := by
        refine lintegral_congr_ae ?_
        filter_upwards [h_tendsto] with x hx
        exact ((f.continuous_mixtureFun.tendsto _).comp hx).liminf_eq.symm
  _ ≤ liminf (fun n ↦ ∫⁻ x, f.mixtureFun ((μ + ν)⁻[p | ℱ n] x) ∂(μ + ν)) atTop :=
        lintegral_liminf_le fun n ↦ f.measurable_mixtureFun.comp (measurable_condLExp' _ _ _)

/-- **Approximation along a filtration**: if a filtration generates the σ-algebra, the
f-divergences between the restrictions of `μ` and `ν` to the σ-algebras of the filtration
converge to `fDiv f μ ν`. -/
theorem tendsto_fDiv_trim_of_iSup_eq [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (ℱ : Filtration ℕ mα) (hℱ : ⨆ n, ℱ n = mα) :
    Tendsto (fun n ↦ fDiv f (μ.trim (ℱ.le n)) (ν.trim (ℱ.le n))) atTop (𝓝 (fDiv f μ ν)) := by
  have h_eq : ∀ (m : MeasurableSpace α) (hm : m ≤ mα), m = mα →
      fDiv f (μ.trim hm) (ν.trim hm) = fDiv f μ ν := by
    rintro _ _ rfl
    simp_rw [trim_eq_self]
  simpa only [h_eq _ _ hℱ] using tendsto_fDiv_trim_iSup (f := f) (μ := μ) (ν := ν) ℱ

/-- **Approximation along a sequence of maps**: if `g n : α → β n` is a sequence of measurable maps
whose induced sigma-algebras increase and generate the sigma-algebra of `α`, the f-divergences
between the pushforwards of `μ` and `ν` by `g n` converge to `fDiv f μ ν`. -/
theorem tendsto_fDiv_map_of_iSup_comap_eq [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    {β : ℕ → Type*} {mβ : ∀ n, MeasurableSpace (β n)} {g : ∀ n, α → β n}
    (hg : ∀ n, Measurable (g n)) (h_mono : Monotone fun n ↦ (mβ n).comap (g n))
    (h_sup : ⨆ n, (mβ n).comap (g n) = mα) :
    Tendsto (fun n ↦ fDiv f (μ.map (g n)) (ν.map (g n))) atTop (𝓝 (fDiv f μ ν)) := by
  simp_rw [fDiv_map_eq_fDiv_trim (hg _)]
  exact tendsto_fDiv_trim_of_iSup_eq ⟨fun n ↦ (mβ n).comap (g n), h_mono, fun n ↦ (hg n).comap_le⟩
    h_sup

end Filtration

section Finite

/-- There is a filtration by finite sub-σ-algebras, which does not depend on the divergence
function `f`, along which the f-divergences of the restrictions of `μ` and `ν` converge to
`fDiv f μ ν`. -/
theorem exists_tendsto_fDiv_trim (μ ν : Measure α) [IsFiniteMeasure μ] [IsFiniteMeasure ν] :
    ∃ ℱ : Filtration ℕ mα, (∀ n, {s | MeasurableSet[ℱ n] s}.Finite) ∧ ∀ f : DivFunction,
      Tendsto (fun n ↦ fDiv f (μ.trim (ℱ.le n)) (ν.trim (ℱ.le n))) atTop (𝓝 (fDiv f μ ν)) := by
  -- the σ-algebra `m₀` generated by `∂μ/∂(μ + ν)` is countably generated and does not change the
  -- f-divergences: we use the filtration of finite σ-algebras which generates it
  have hm₀ := (μ.measurable_rnDeriv (μ + ν)).comap_le
  set m₀ : MeasurableSpace α := MeasurableSpace.comap (∂μ/∂(μ + ν)) inferInstance
  have : @MeasurableSpace.CountablyGenerated α m₀ := MeasurableSpace.CountablyGenerated.comap _
  let ℱ : Filtration ℕ mα :=
    ⟨@countableFiltration α m₀ _, (@countableFiltration α m₀ _).mono',
      fun n ↦ ((@countableFiltration α m₀ _).le n).trans hm₀⟩
  refine ⟨ℱ, fun n ↦ @finite_setOf_measurableSet_countableFiltration α m₀ _ n, fun f ↦ ?_⟩
  have h_eq : ∀ (m : MeasurableSpace α) (hm : m ≤ mα), m = m₀ →
      fDiv f (μ.trim hm) (ν.trim hm) = fDiv f μ ν := by
    rintro _ _ rfl
    exact fDiv_trim_comap_rnDeriv_add
  simpa only [h_eq _ _ (@iSup_countableFiltration α m₀ _)] using
    tendsto_fDiv_trim_iSup (f := f) (μ := μ) (ν := ν) ℱ

/-- **The f-divergence is the supremum over finite sub-σ-algebras**: for finite measures,
`fDiv f μ ν` is the supremum of the f-divergences between the restrictions of `μ` and `ν` to the
finite sub-σ-algebras. -/
theorem fDiv_eq_iSup_fDiv_trim [IsFiniteMeasure μ] [IsFiniteMeasure ν] :
    fDiv f μ ν = ⨆ (m : MeasurableSpace α) (hm : m ≤ mα)
      (_ : {s | MeasurableSet[m] s}.Finite), fDiv f (μ.trim hm) (ν.trim hm) := by
  refine le_antisymm ?_ (iSup_le fun m ↦ iSup₂_le fun hm _ ↦ fDiv_trim_le hm)
  obtain ⟨ℱ, hℱ_fin, h_tendsto⟩ := exists_tendsto_fDiv_trim μ ν
  exact le_of_tendsto' (h_tendsto f) fun n ↦
    le_iSup_of_le (ℱ n) (le_iSup_of_le (ℱ.le n) (le_iSup_of_le (hℱ_fin n) le_rfl))

end Finite

end ProbabilityTheory
