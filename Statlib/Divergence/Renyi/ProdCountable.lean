module

public import Mathlib.Analysis.SpecialFunctions.Log.ENNRealLogExp
public import Mathlib.Probability.ProductMeasure
public import Statlib.Divergence.FDiv.TrimApprox
public import Statlib.Divergence.Renyi.Prod
public import Statlib.ForMathlib.Probability.Process.Filtration

/-!
# Tensorization of the Rényi divergence for countable products

For a countable family of probability measures, the Rényi divergence of order `a > 0` between the
product measures `Measure.infinitePi μ` and `Measure.infinitePi ν` is the sum of the Rényi
divergences between the factors.

The finite products `Measure.pi (fun i : s n ↦ μ i)` over an increasing sequence of finite sets
`s n` exhausting the index set are the pushforwards of the infinite product by the restrictions,
whose σ-algebras increase and generate the product σ-algebra. By
`tendsto_renyiDiv_map_of_iSup_comap_eq`, the Rényi divergences between the finite products converge
to the divergence between the infinite products, and the Rényi divergence tensorizes on finite
products (`renyiDiv_pi`).

The hypothesis `0 < a` cannot be dropped in `renyiDiv_infinitePi` (only the inequality
`tsum_renyiDiv_le_renyiDiv_infinitePi` holds for `a = 0`): if `μ i` and `ν i` are equivalent
Bernoulli distributions with parameters `1/2` and `1/3`, then `R₀(μ i, ν i) = 0` for all `i`, but
the infinite products are mutually singular, hence `R₀(∏ μ i, ∏ ν i) = ∞`.

## Main statements

* `ProbabilityTheory.tendsto_renyiDiv_map_of_iSup_comap_eq`: for finite measures and `0 < a`, if the
  σ-algebras generated by the maps `g n` increase to the whole σ-algebra, then
  `Rₐ(μ.map (g n), ν.map (g n)) → Rₐ(μ, ν)`.
* `ProbabilityTheory.tsum_renyiDiv_le_renyiDiv_infinitePi`: for any index set and `0 ≤ a`, the sum
  of the Rényi divergences is at most the Rényi divergence between the products.
* `ProbabilityTheory.renyiDiv_infinitePi`: `Rₐ(∏ μ i, ∏ ν i) = ∑' i, Rₐ(μ i, ν i)` for a countable
  index set and `0 < a`.

## References

* T. van Erven, P. Harremoës, *Rényi divergence and Kullback-Leibler divergence*, IEEE
  Transactions on Information Theory 60(7) (2014), Theorem 28.
-/

@[expose] public section

open Real MeasureTheory Filter Set

open scoped ENNReal Topology

namespace ProbabilityTheory

variable {α : Type*} {mα : MeasurableSpace α} {μ ν : Measure α} {a : ℝ}

/-- `tendsto_renyiDiv_map_of_iSup_comap_eq` for probability measures. -/
private lemma tendsto_renyiDiv_map_of_iSup_comap_eq_of_isProbabilityMeasure (ha : 0 < a)
    (μ ν : Measure α) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] {β : ℕ → Type*}
    {mβ : ∀ n, MeasurableSpace (β n)} {g : ∀ n, α → β n} (hg : ∀ n, Measurable (g n))
    (h_mono : Monotone fun n ↦ (mβ n).comap (g n)) (h_sup : ⨆ n, (mβ n).comap (g n) = mα) :
    Tendsto (fun n ↦ renyiDiv a (μ.map (g n)) (ν.map (g n))) atTop (𝓝 (renyiDiv a μ ν)) := by
  have h_tendsto (f : DivFunction) := tendsto_fDiv_map_of_iSup_comap_eq (μ := μ) (ν := ν) (f := f)
    hg h_mono h_sup
  rcases eq_or_ne a 1 with rfl | ha1
  · simp_rw [renyiDiv_one_of_isProbabilityMeasure, klDiv_eq_fDiv]
    exact h_tendsto klDivFun
  -- for `a ≠ 1`, the Rényi divergence is a continuous function of the Hellinger divergence
  have h_cont : Continuous fun h : ℝ≥0∞ ↦ (((a - 1)⁻¹ : ℝ) * ENNReal.log
      ((1 + ((a - 1 : ℝ) : EReal) * h).toENNReal) : EReal).toENNReal :=
    EReal.continuous_toENNReal.comp ((EReal.continuous_coe_mul _).comp
      (ENNReal.continuous_log.comp (EReal.continuous_toENNReal.comp
        ((EReal.continuous_coe_add 1).comp
          ((EReal.continuous_coe_mul _).comp continuous_coe_ennreal_ereal)))))
  simp_rw [renyiDiv_of_ne_one_of_isProbabilityMeasure ha.ne' ha1]
  exact (h_cont.tendsto _).comp (h_tendsto (hellingerDivFun a))

/-- If the σ-algebras generated by measurable maps `g n` increase to the σ-algebra of the space,
then for `0 < a` the Rényi divergences between the pushforwards by `g n` of two finite measures
converge to the Rényi divergence between the measures. -/
theorem tendsto_renyiDiv_map_of_iSup_comap_eq (ha : 0 < a) (μ ν : Measure α)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] {β : ℕ → Type*}
    {mβ : ∀ n, MeasurableSpace (β n)} {g : ∀ n, α → β n} (hg : ∀ n, Measurable (g n))
    (h_mono : Monotone fun n ↦ (mβ n).comap (g n)) (h_sup : ⨆ n, (mβ n).comap (g n) = mα) :
    Tendsto (fun n ↦ renyiDiv a (μ.map (g n)) (ν.map (g n))) atTop (𝓝 (renyiDiv a μ ν)) := by
  rcases eq_zero_or_neZero μ with rfl | _
  · -- the divergence from the zero measure only depends on the mass of the second measure
    refine tendsto_const_nhds.congr fun n ↦ ?_
    rw [Measure.map_zero]
    rcases eq_or_ne a 1 with rfl | ha1
    · simp_rw [renyiDiv_one, Measure.coe_zero, Pi.zero_apply, smul_zero,
        InformationTheory.klDiv_of_ac_of_integrable (.zero _) integrable_zero_measure]
      simp [measureReal_def, Measure.map_apply (hg n) .univ]
    · simp [renyiDiv_zero_measure_left ha.le ha1]
  have (n : ℕ) : NeZero (μ.map (g n)) :=
    ⟨(Measure.map_ne_zero_iff (hg n).aemeasurable).2 (NeZero.ne μ)⟩
  rcases eq_zero_or_neZero ν with rfl | _
  · simp [renyiDiv_zero_measure_right ha.le]
  -- reduce to probability measures by normalizing
  have h_eq (n : ℕ) : renyiDiv a (μ.map (g n)) (ν.map (g n))
      = renyiDiv a (((μ .univ)⁻¹ • μ).map (g n)) (((ν .univ)⁻¹ • ν).map (g n)) := by
    rw [Measure.map_smul, Measure.map_smul, renyiDiv_smul_smul ha.le]
    all_goals first | exact (hg n).aemeasurable | simp [NeZero.ne, measure_ne_top]
  simp_rw [h_eq, renyiDiv_eq_renyiDiv_inv_smul ha.le (μ := μ)]
  exact tendsto_renyiDiv_map_of_iSup_comap_eq_of_isProbabilityMeasure ha _ _ hg h_mono h_sup

universe u

variable {ι : Type*} {β : ι → Type u} [∀ i, MeasurableSpace (β i)]

/-- For products of probability measures and `0 ≤ a`, the sum of the Rényi divergences between the
factors is at most the Rényi divergence between the products. -/
theorem tsum_renyiDiv_le_renyiDiv_infinitePi (ha : 0 ≤ a) (μ ν : (i : ι) → Measure (β i))
    [∀ i, IsProbabilityMeasure (μ i)] [∀ i, IsProbabilityMeasure (ν i)] :
    ∑' i, renyiDiv a (μ i) (ν i) ≤ renyiDiv a (Measure.infinitePi μ) (Measure.infinitePi ν) := by
  rw [tsum_eq_iSup_sum]
  refine iSup_le fun s ↦ ?_
  calc ∑ i ∈ s, renyiDiv a (μ i) (ν i) = ∑ i : s, renyiDiv a (μ i) (ν i) :=
        (Finset.sum_coe_sort s _).symm
  _ = renyiDiv a (Measure.pi fun i : s ↦ μ i) (Measure.pi fun i : s ↦ ν i) :=
        (renyiDiv_pi ha).symm
  _ ≤ renyiDiv a (Measure.infinitePi μ) (Measure.infinitePi ν) := by
        rw [← Measure.infinitePi_map_restrict, ← Measure.infinitePi_map_restrict]
        exact renyiDiv_map_le ha _ _ (Finset.measurable_restrict s)

/-- **Tensorization of the Rényi divergence for countable products**: for a countable family of
probability measures and `0 < a`, `Rₐ(∏ μ i, ∏ ν i) = ∑' i, Rₐ(μ i, ν i)`. -/
theorem renyiDiv_infinitePi [Countable ι] (ha : 0 < a) (μ ν : (i : ι) → Measure (β i))
    [∀ i, IsProbabilityMeasure (μ i)] [∀ i, IsProbabilityMeasure (ν i)] :
    renyiDiv a (Measure.infinitePi μ) (Measure.infinitePi ν) = ∑' i, renyiDiv a (μ i) (ν i) := by
  -- restrict to an increasing sequence of finite sets `s n` exhausting `ι`
  obtain ⟨s, hs_mono, hs_tendsto⟩ := exists_seq_monotone_tendsto_atTop_atTop (Finset ι)
  have hs i : ∃ n, i ∈ s n :=
    ((tendsto_atTop.1 hs_tendsto {i}).exists).imp fun _ h ↦ Finset.singleton_subset_iff.1 h
  refine tendsto_nhds_unique (tendsto_renyiDiv_map_of_iSup_comap_eq ha _ _
    (fun n ↦ Finset.measurable_restrict (s n))
    (fun _ _ hmn ↦ Filtration.piFinset.mono (hs_mono hmn))
    (Filtration.iSup_piFinset_eq_pi hs)) ?_
  simp_rw [Measure.infinitePi_map_restrict, renyiDiv_pi ha.le,
    Finset.sum_coe_sort _ fun i ↦ renyiDiv a (μ i) (ν i)]
  exact CompleteLattice.summable.hasSum.comp hs_tendsto

end ProbabilityTheory
