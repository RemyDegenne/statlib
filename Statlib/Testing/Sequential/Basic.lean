module

public import Mathlib.MeasureTheory.Measure.LogLikelihoodRatio
public import Mathlib.Probability.ProductMeasure
public import Statlib.ForMathlib.MeasureTheory.Measure.Decomposition.RNDerivProd
public import Statlib.ForMathlib.MeasureTheory.Measure.Decomposition.RNDerivTrim
public import Statlib.ForMathlib.MeasureTheory.Measure.Trim
public import Statlib.ForMathlib.Probability.Process.Filtration
public import Statlib.ForMathlib.Probability.Process.Stopping
public import Statlib.ForMathlib.Probability.ProductMeasure

/-!
# Likelihood ratios of i.i.d. sequences observed up to a stopping time

For a probability measure `μ` on `𝓧`, let `μ^ℕ = Measure.infinitePi (fun _ : ℕ ↦ μ)` be the law of
an i.i.d. sequence with law `μ`. We consider the filtration `Filtration.piLE` on `ℕ → 𝓧`, in which
the σ-algebra at time `n` is generated by the first `n + 1` coordinates `ω 0, …, ω n`, and a
stopping time `τ` for that filtration, with values in `ℕ`. The observations available at time `τ`
are `ω 0, …, ω (τ ω)`, and `μ_τ` denotes the restriction of `μ^ℕ` to the σ-algebra of the stopping
time.

Note that `μ^ℕ` and `ν^ℕ` are mutually singular as soon as `μ ≠ ν`: we cannot obtain the
Radon-Nikodym derivatives of the restrictions from a Radon-Nikodym derivative `∂μ^ℕ/∂ν^ℕ`.

## Main statements

* `rnDeriv_trim_piLE_infinitePi`: the Radon-Nikodym derivative of the restrictions of `μ^ℕ` and
  `ν^ℕ` to the σ-algebra at time `n` is `ω ↦ ∏ i ≤ n, ∂μ/∂ν (ω i)`.
* `trim_piLE_infinitePi_eq_withDensity`: for `μ ≪ ν`, the restriction of `μ^ℕ` to the σ-algebra at
  time `n` has density `ω ↦ ∏ i ≤ n, ∂μ/∂ν (ω i)` with respect to the restriction of `ν^ℕ`.
* `rnDeriv_trim_stoppingTime_infinitePi`, `trim_stoppingTime_infinitePi_eq_withDensity`: the same
  statements for the σ-algebra of the stopping time `τ`, with density
  `ω ↦ ∏ i ≤ τ ω, ∂μ/∂ν (ω i)`.
* `llr_trim_piLE_infinitePi_ae_eq`, `llr_trim_stoppingTime_infinitePi_ae_eq`: for `μ ≪ ν`, the
  log-likelihood ratios of these restrictions are `μ^ℕ`-almost surely equal to
  `ω ↦ ∑ i ≤ n, llr μ ν (ω i)` and `ω ↦ ∑ i ≤ τ ω, llr μ ν (ω i)`.

## Implementation notes

The stopping time `τ` takes values in `ℕ` and the stopping time property is stated for its coercion
`fun ω ↦ (τ ω : WithTop ℕ)`, as required by `MeasureTheory.IsStoppingTime`.
-/

@[expose] public section

open MeasureTheory Filtration

open scoped ENNReal

namespace ProbabilityTheory

variable {𝓧 : Type*} {m𝓧 : MeasurableSpace 𝓧} {μ ν : Measure 𝓧}

section Filtration

/-- A product of functions of the first `n + 1` coordinates is measurable at time `n`. -/
lemma measurable_piLE_prod (n : ℕ) {f : 𝓧 → ℝ≥0∞} (hf : Measurable f) :
    Measurable[piLE (X := fun _ : ℕ ↦ 𝓧) n] fun ω ↦ ∏ i ∈ Finset.Iic n, f (ω i) :=
  Finset.measurable_prod _ fun _ hi ↦ hf.comp (measurable_piLE_apply (Finset.mem_Iic.mp hi))

/-- The Radon-Nikodym derivative of the restrictions of `μ^ℕ` and `ν^ℕ` to the σ-algebra generated
by the first `n + 1` coordinates is `ω ↦ ∏ i ≤ n, ∂μ/∂ν (ω i)`. -/
lemma rnDeriv_trim_piLE_infinitePi [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] (n : ℕ) :
    ((Measure.infinitePi fun _ : ℕ ↦ μ).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n)).rnDeriv
        ((Measure.infinitePi fun _ : ℕ ↦ ν).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n))
      =ᵐ[(Measure.infinitePi fun _ : ℕ ↦ ν).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n)]
        fun ω ↦ ∏ i ∈ Finset.Iic n, μ.rnDeriv ν (ω i) := by
  have hg := Preorder.measurable_restrictLe (X := fun _ : ℕ ↦ 𝓧) n
  refine (rnDeriv_trim_comap_ae_eq hg).trans (ae_eq_trim_of_measurable _
    ((Measure.measurable_rnDeriv _ _).comp (comap_measurable _))
    (measurable_piLE_prod n (Measure.measurable_rnDeriv _ _)) ?_)
  have h_pi := Measure.rnDeriv_pi (μ := fun _ : Set.Iic n ↦ μ) (ν := fun _ ↦ ν)
  rw [← Measure.infinitePi_map_restrictLe (fun _ ↦ ν) n,
    ← Measure.infinitePi_map_restrictLe (fun _ ↦ μ) n] at h_pi
  filter_upwards [ae_of_ae_map hg.aemeasurable h_pi] with ω hω
  rw [hω]
  exact (Finset.prod_subtype (Finset.Iic n) (fun _ ↦ by simp) (fun i ↦ μ.rnDeriv ν (ω i))).symm

/-- For `μ ≪ ν`, the restriction of `μ^ℕ` to the σ-algebra generated by the first `n + 1`
coordinates is absolutely continuous with respect to the restriction of `ν^ℕ`. -/
lemma absolutelyContinuous_trim_piLE_infinitePi [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμν : μ ≪ ν) (n : ℕ) :
    (Measure.infinitePi fun _ : ℕ ↦ μ).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n)
      ≪ (Measure.infinitePi fun _ : ℕ ↦ ν).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n) := by
  refine (absolutelyContinuous_trim_comap_iff (Preorder.measurable_restrictLe n)).mpr ?_
  rw [Measure.infinitePi_map_restrictLe, Measure.infinitePi_map_restrictLe,
    Measure.pi_eq_withDensity_prod_rnDeriv fun _ ↦ hμν]
  exact withDensity_absolutelyContinuous _ _

/-- For `μ ≪ ν`, the restriction of `μ^ℕ` to the σ-algebra generated by the first `n + 1`
coordinates has density `ω ↦ ∏ i ≤ n, ∂μ/∂ν (ω i)` with respect to the restriction of `ν^ℕ`. -/
lemma trim_piLE_infinitePi_eq_withDensity [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμν : μ ≪ ν) (n : ℕ) :
    (Measure.infinitePi fun _ : ℕ ↦ μ).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n)
      = ((Measure.infinitePi fun _ : ℕ ↦ ν).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n)).withDensity
        fun ω ↦ ∏ i ∈ Finset.Iic n, μ.rnDeriv ν (ω i) := by
  conv_lhs =>
    rw [← Measure.withDensity_rnDeriv_eq _ _ (absolutelyContinuous_trim_piLE_infinitePi hμν n)]
  exact withDensity_congr_ae (rnDeriv_trim_piLE_infinitePi n)

/-- For `μ ≪ ν`, `μ^ℕ`-almost surely, `log (∏ i ∈ s, ∂μ/∂ν (ω i)) = ∑ i ∈ s, llr μ ν (ω i)` for
all finite sets `s`. -/
lemma ae_log_prod_rnDeriv_eq_sum_llr [IsProbabilityMeasure μ] [SigmaFinite ν] (hμν : μ ≪ ν) :
    ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ μ), ∀ s : Finset ℕ,
      Real.log (∏ i ∈ s, μ.rnDeriv ν (ω i)).toReal = ∑ i ∈ s, llr μ ν (ω i) := by
  have h_pos : ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ μ), ∀ i, (μ.rnDeriv ν (ω i)).toReal ≠ 0 := by
    refine ae_all_iff.2 fun i ↦ (measurePreserving_eval_infinitePi (fun _ : ℕ ↦ μ) i)
      |>.quasiMeasurePreserving.ae (p := fun x ↦ (μ.rnDeriv ν x).toReal ≠ 0) ?_
    filter_upwards [Measure.rnDeriv_pos hμν, hμν.ae_le (Measure.rnDeriv_lt_top μ ν)] with x h1 h2
    exact ENNReal.toReal_ne_zero.mpr ⟨h1.ne', h2.ne⟩
  filter_upwards [h_pos] with ω hω s
  rw [ENNReal.toReal_prod, Real.log_prod fun i _ ↦ hω i]
  rfl

/-- For `μ ≪ ν`, the log-likelihood ratio of the restrictions of `μ^ℕ` and `ν^ℕ` to the σ-algebra
generated by the first `n + 1` coordinates is `ω ↦ ∑ i ≤ n, llr μ ν (ω i)`. -/
lemma llr_trim_piLE_infinitePi_ae_eq [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμν : μ ≪ ν) (n : ℕ) :
    llr ((Measure.infinitePi fun _ : ℕ ↦ μ).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n))
        ((Measure.infinitePi fun _ : ℕ ↦ ν).trim ((piLE (X := fun _ : ℕ ↦ 𝓧)).le n))
      =ᵐ[Measure.infinitePi fun _ : ℕ ↦ μ] fun ω ↦ ∑ i ∈ Finset.Iic n, llr μ ν (ω i) := by
  filter_upwards [ae_of_ae_trim _ ((absolutelyContinuous_trim_piLE_infinitePi hμν n).ae_le
    (rnDeriv_trim_piLE_infinitePi (μ := μ) n)), ae_log_prod_rnDeriv_eq_sum_llr hμν]
    with ω h_rn h_log
  rw [llr, h_rn, h_log]

end Filtration

section StoppingTime

variable {τ : (ℕ → 𝓧) → ℕ}

/-- A product of functions of the observations up to a stopping time `τ` is measurable with respect
to the σ-algebra of `τ`. -/
lemma measurable_stoppingTime_prod
    (hτ : IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) (fun ω ↦ (τ ω : WithTop ℕ)))
    {f : 𝓧 → ℝ≥0∞} (hf : Measurable f) :
    Measurable[hτ.measurableSpace] fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), f (ω i) := by
  have h_adapted : StronglyAdapted (piLE (X := fun _ : ℕ ↦ 𝓧))
      (fun n ω ↦ ∏ i ∈ Finset.Iic n, f (ω i)) :=
    fun n ↦ (measurable_piLE_prod n hf).stronglyMeasurable
  exact measurable_stoppedValue h_adapted.isStronglyProgressive_of_discrete hτ

/-- For `μ ≪ ν` and a stopping time `τ` with values in `ℕ`, the restriction of `μ^ℕ` to the
σ-algebra of `τ` has density `ω ↦ ∏ i ≤ τ ω, ∂μ/∂ν (ω i)` with respect to the restriction of
`ν^ℕ`. -/
lemma trim_stoppingTime_infinitePi_eq_withDensity [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hμν : μ ≪ ν)
    (hτ : IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) (fun ω ↦ (τ ω : WithTop ℕ))) :
    (Measure.infinitePi fun _ : ℕ ↦ μ).trim hτ.measurableSpace_le
      = ((Measure.infinitePi fun _ : ℕ ↦ ν).trim hτ.measurableSpace_le).withDensity
        fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), μ.rnDeriv ν (ω i) :=
  trim_stoppingTime_eq_withDensity (ℱ := piLE (X := fun _ : ℕ ↦ 𝓧))
    (P := Measure.infinitePi fun _ : ℕ ↦ μ) (Q := Measure.infinitePi fun _ : ℕ ↦ ν)
    (L := fun n ω ↦ ∏ i ∈ Finset.Iic n, μ.rnDeriv ν (ω i))
    (fun n ↦ measurable_piLE_prod n (μ.measurable_rnDeriv ν))
    (trim_piLE_infinitePi_eq_withDensity hμν) hτ

/-- For `μ ≪ ν`, the restriction of `μ^ℕ` to the σ-algebra of a stopping time is absolutely
continuous with respect to the restriction of `ν^ℕ`. -/
lemma absolutelyContinuous_trim_stoppingTime_infinitePi [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hμν : μ ≪ ν)
    (hτ : IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) (fun ω ↦ (τ ω : WithTop ℕ))) :
    (Measure.infinitePi fun _ : ℕ ↦ μ).trim hτ.measurableSpace_le
      ≪ (Measure.infinitePi fun _ : ℕ ↦ ν).trim hτ.measurableSpace_le := by
  rw [trim_stoppingTime_infinitePi_eq_withDensity hμν hτ]
  exact withDensity_absolutelyContinuous _ _

/-- For a stopping time `τ` with values in `ℕ`, the Radon-Nikodym derivative of the restrictions of
`μ^ℕ` and `ν^ℕ` to the σ-algebra of `τ` is `ω ↦ ∏ i ≤ τ ω, ∂μ/∂ν (ω i)`. -/
lemma rnDeriv_trim_stoppingTime_infinitePi [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hτ : IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) (fun ω ↦ (τ ω : WithTop ℕ))) :
    ((Measure.infinitePi fun _ : ℕ ↦ μ).trim hτ.measurableSpace_le).rnDeriv
        ((Measure.infinitePi fun _ : ℕ ↦ ν).trim hτ.measurableSpace_le)
      =ᵐ[(Measure.infinitePi fun _ : ℕ ↦ ν).trim hτ.measurableSpace_le]
        fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), μ.rnDeriv ν (ω i) := by
  -- both restrictions have densities with respect to the restriction of `ρ^ℕ`, where
  -- `ρ = (μ + ν) / 2`
  set ρ : Measure 𝓧 := (2 : ℝ≥0∞)⁻¹ • (μ + ν)
  have : IsProbabilityMeasure ρ :=
    ⟨by simp [ρ, ENNReal.inv_two_add_inv_two]⟩
  have hμρ : μ ≪ ρ := (Measure.AbsolutelyContinuous.rfl.add_right ν).trans
    (Measure.absolutelyContinuous_smul (by simp))
  have hνρ : ν ≪ ρ := (Measure.AbsolutelyContinuous.rfl.add_right' μ).trans
    (Measure.absolutelyContinuous_smul (by simp))
  set hm := hτ.measurableSpace_le
  have h_meas (κ : Measure 𝓧) := measurable_stoppingTime_prod hτ (κ.measurable_rnDeriv ρ)
  have hμ := trim_stoppingTime_infinitePi_eq_withDensity hμρ hτ
  have hν := trim_stoppingTime_infinitePi_eq_withDensity hνρ hτ
  have h_acμ := absolutelyContinuous_trim_stoppingTime_infinitePi hμρ hτ
  have h_acν := absolutelyContinuous_trim_stoppingTime_infinitePi hνρ hτ
  have h_rnμ : ((Measure.infinitePi fun _ : ℕ ↦ μ).trim hm).rnDeriv
        ((Measure.infinitePi fun _ : ℕ ↦ ρ).trim hm)
      =ᵐ[(Measure.infinitePi fun _ : ℕ ↦ ρ).trim hm]
        fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), μ.rnDeriv ρ (ω i) := by
    rw [hμ]
    exact Measure.rnDeriv_withDensity _ (h_meas μ)
  have h_rnν : ((Measure.infinitePi fun _ : ℕ ↦ ν).trim hm).rnDeriv
        ((Measure.infinitePi fun _ : ℕ ↦ ρ).trim hm)
      =ᵐ[(Measure.infinitePi fun _ : ℕ ↦ ρ).trim hm]
        fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), ν.rnDeriv ρ (ω i) := by
    rw [hν]
    exact Measure.rnDeriv_withDensity _ (h_meas ν)
  -- coordinatewise, `∂μ/∂ν = ∂μ/∂ρ / ∂ν/∂ρ`, `ν`-almost everywhere
  have h_coord : (fun ω ↦ ∏ i ∈ Finset.Iic (τ ω), μ.rnDeriv ν (ω i))
      =ᵐ[(Measure.infinitePi fun _ : ℕ ↦ ν).trim hm] fun ω ↦ (∏ i ∈ Finset.Iic (τ ω),
        μ.rnDeriv ρ (ω i)) / ∏ i ∈ Finset.Iic (τ ω), ν.rnDeriv ρ (ω i) := by
    refine (StronglyMeasurable.ae_eq_trim_iff hm
      (measurable_stoppingTime_prod hτ (μ.measurable_rnDeriv ν)).stronglyMeasurable
      ((h_meas μ).div (h_meas ν)).stronglyMeasurable).mpr ?_
    have h_eval (i : ℕ) :=
      (measurePreserving_eval_infinitePi (fun _ : ℕ ↦ ν) i).quasiMeasurePreserving
    have h_div : ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ ν), ∀ i,
        μ.rnDeriv ν (ω i) = μ.rnDeriv ρ (ω i) / ν.rnDeriv ρ (ω i) :=
      ae_all_iff.2 fun i ↦ (h_eval i).ae (Measure.rnDeriv_eq_div hμρ hνρ)
    have h_top : ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ ν), ∀ i, ν.rnDeriv ρ (ω i) ≠ ∞ :=
      ae_all_iff.2 fun i ↦ (h_eval i).ae (hνρ.ae_le (Measure.rnDeriv_ne_top _ _))
    filter_upwards [h_div, h_top] with ω h_div h_top
    rw [Finset.prod_congr rfl fun i _ ↦ h_div i,
      ENNReal.prod_div_distrib_of_ne_top fun i _ ↦ h_top i, Pi.div_apply]
  filter_upwards [Measure.rnDeriv_eq_div h_acμ h_acν, h_acν.ae_le h_rnμ, h_acν.ae_le h_rnν, h_coord]
    with ω h1 h2 h3 h4
  rw [h1, h2, h3, h4]

/-- For `μ ≪ ν` and a stopping time `τ` with values in `ℕ`, the log-likelihood ratio of the
restrictions of `μ^ℕ` and `ν^ℕ` to the σ-algebra of `τ` is `ω ↦ ∑ i ≤ τ ω, llr μ ν (ω i)`. -/
lemma llr_trim_stoppingTime_infinitePi_ae_eq [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμν : μ ≪ ν) (hτ : IsStoppingTime (piLE (X := fun _ : ℕ ↦ 𝓧)) (fun ω ↦ (τ ω : WithTop ℕ))) :
    llr ((Measure.infinitePi fun _ : ℕ ↦ μ).trim hτ.measurableSpace_le)
        ((Measure.infinitePi fun _ : ℕ ↦ ν).trim hτ.measurableSpace_le)
      =ᵐ[Measure.infinitePi fun _ : ℕ ↦ μ] fun ω ↦ ∑ i ∈ Finset.Iic (τ ω), llr μ ν (ω i) := by
  filter_upwards [ae_of_ae_trim _ ((absolutelyContinuous_trim_stoppingTime_infinitePi hμν hτ).ae_le
    (rnDeriv_trim_stoppingTime_infinitePi (μ := μ) hτ)), ae_log_prod_rnDeriv_eq_sum_llr hμν]
    with ω h_rn h_log
  rw [llr, h_rn, h_log]

end StoppingTime

end ProbabilityTheory
