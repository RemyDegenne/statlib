module

public import Mathlib.MeasureTheory.Measure.Decomposition.RadonNikodym
public import Statlib.ForMathlib.MeasureTheory.Measure.Trim

/-!
# Radon-Nikodym derivative of a restriction to the σ-algebra induced by a map

For a measurable function `g : 𝓧 → 𝓨`, the restrictions of measures `μ` and `ν` to the σ-algebra
`m𝓨.comap g` are isomorphic to the pushforwards `μ.map g` and `ν.map g`. In particular, the
Radon-Nikodym derivative of the restrictions is `x ↦ ∂(μ.map g)/∂(ν.map g) (g x)`.

None of these statements requires `μ ≪ ν` on the whole space: for infinite product measures for
example, `μ` and `ν` are typically mutually singular while their restrictions to the σ-algebras
generated by finitely many coordinates are not.

## Main statements

* `absolutelyContinuous_trim_comap_iff`: `μ.trim _ ≪ ν.trim _ ↔ μ.map g ≪ ν.map g`.
* `trim_comap_eq_withDensity`: if `μ.map g ≪ ν.map g`, the restriction of `μ` to `m𝓨.comap g` has
  density `x ↦ ∂(μ.map g)/∂(ν.map g) (g x)` with respect to the restriction of `ν`.
* `rnDeriv_trim_comap_ae_eq`: `∂(μ.trim _)/∂(ν.trim _) =ᵐ[ν.trim _] ∂(μ.map g)/∂(ν.map g) ∘ g`.
* `rnDeriv_map_comp_ae_eq_rnDeriv_trim`: the same, `ν`-almost everywhere.

See `MeasureTheory.rnDeriv_map` and `MeasureTheory.rnDeriv_trim` for the expressions of these
Radon-Nikodym derivatives as conditional expectations of `∂μ/∂ν`, when `μ ≪ ν`.
-/

@[expose] public section

open scoped ENNReal

namespace MeasureTheory

variable {𝓧 𝓨 : Type*} {m𝓧 : MeasurableSpace 𝓧} {m𝓨 : MeasurableSpace 𝓨} {μ ν : Measure 𝓧}
  {g : 𝓧 → 𝓨}

/-- The restrictions of `μ` and `ν` to the σ-algebra `m𝓨.comap g` are absolutely continuous if and
only if the pushforwards `μ.map g` and `ν.map g` are. -/
lemma absolutelyContinuous_trim_comap_iff (hg : Measurable g) :
    μ.trim hg.comap_le ≪ ν.trim hg.comap_le ↔ μ.map g ≪ ν.map g := by
  refine ⟨fun h ↦ ?_, fun h ↦ Measure.AbsolutelyContinuous.mk fun s hs hνs ↦ ?_⟩
  · rw [← map_trim_comap hg, ← map_trim_comap (μ := ν) hg]
    exact h.map (comap_measurable g)
  · obtain ⟨t, ht, rfl⟩ := hs
    have hs : MeasurableSet[m𝓨.comap g] (g ⁻¹' t) := ⟨t, ht, rfl⟩
    rw [trim_measurableSet_eq hg.comap_le hs, ← Measure.map_apply hg ht] at hνs ⊢
    exact h hνs

/-- If `μ.map g ≪ ν.map g`, the restriction of `μ` to the σ-algebra `m𝓨.comap g` has density
`x ↦ ∂(μ.map g)/∂(ν.map g) (g x)` with respect to the restriction of `ν`. -/
lemma trim_comap_eq_withDensity [SFinite (ν.map g)] [(μ.map g).HaveLebesgueDecomposition (ν.map g)]
    (hg : Measurable g) (h_ac : μ.map g ≪ ν.map g) :
    μ.trim hg.comap_le
      = (ν.trim hg.comap_le).withDensity fun x ↦ (μ.map g).rnDeriv (ν.map g) (g x) := by
  have hf_meas : Measurable[m𝓨.comap g] fun x ↦ (μ.map g).rnDeriv (ν.map g) (g x) :=
    (Measure.measurable_rnDeriv _ _).comp (comap_measurable g)
  refine @Measure.ext _ (m𝓨.comap g) _ _ fun s hs ↦ ?_
  obtain ⟨t, ht, rfl⟩ := hs
  have hs : MeasurableSet[m𝓨.comap g] (g ⁻¹' t) := ⟨t, ht, rfl⟩
  rw [trim_measurableSet_eq hg.comap_le hs, withDensity_apply _ hs,
    setLIntegral_trim hg.comap_le hf_meas hs, ← Measure.map_apply hg ht,
    ← setLIntegral_map ht (Measure.measurable_rnDeriv _ _) hg, Measure.setLIntegral_rnDeriv h_ac]

/-- The Radon-Nikodym derivative of the restrictions of `μ` and `ν` to the σ-algebra `m𝓨.comap g`
is `x ↦ ∂(μ.map g)/∂(ν.map g) (g x)`. -/
lemma rnDeriv_trim_comap_ae_eq [SigmaFinite (μ.map g)] [SigmaFinite (ν.map g)]
    (hg : Measurable g) :
    (μ.trim hg.comap_le).rnDeriv (ν.trim hg.comap_le)
      =ᵐ[ν.trim hg.comap_le] fun x ↦ (μ.map g).rnDeriv (ν.map g) (g x) := by
  -- we compare both sides through their densities with respect to `ξ = μ + ν`
  set ξ := μ + ν
  have := sigmaFinite_trim_comap (μ := μ) hg
  have := sigmaFinite_trim_comap (μ := ν) hg
  have h_map : ξ.map g = μ.map g + ν.map g := Measure.map_add _ _ hg
  have h_trim : ξ.trim hg.comap_le = μ.trim hg.comap_le + ν.trim hg.comap_le := trim_add _
  have hμξ : μ.map g ≪ ξ.map g := h_map ▸ Measure.AbsolutelyContinuous.rfl.add_right _
  have hνξ : ν.map g ≪ ξ.map g := h_map ▸ Measure.AbsolutelyContinuous.rfl.add_right' _
  have hξ_trim : ν.trim hg.comap_le ≪ ξ.trim hg.comap_le :=
    h_trim ▸ Measure.AbsolutelyContinuous.rfl.add_right' _
  have : SigmaFinite (ξ.map g) := h_map ▸ inferInstance
  have : SigmaFinite (ξ.trim hg.comap_le) := h_trim ▸ inferInstance
  have h_rn (κ : Measure 𝓧) [SigmaFinite (κ.map g)] (hκ : κ.map g ≪ ξ.map g) :
      (κ.trim hg.comap_le).rnDeriv (ξ.trim hg.comap_le)
        =ᵐ[ξ.trim hg.comap_le] fun x ↦ (κ.map g).rnDeriv (ξ.map g) (g x) := by
    rw [trim_comap_eq_withDensity hg hκ]
    exact Measure.rnDeriv_withDensity _ ((Measure.measurable_rnDeriv _ _).comp (comap_measurable g))
  have h_div : ∀ᵐ y ∂@Measure.map _ _ (m𝓨.comap g) _ g (ν.trim hg.comap_le),
      (μ.map g).rnDeriv (ν.map g) y
      = (μ.map g).rnDeriv (ξ.map g) y / (ν.map g).rnDeriv (ξ.map g) y := by
    rw [map_trim_comap hg]
    exact Measure.rnDeriv_eq_div hμξ hνξ
  filter_upwards [Measure.rnDeriv_eq_div (h_trim ▸ Measure.AbsolutelyContinuous.rfl.add_right _)
      hξ_trim, hξ_trim (h_rn μ hμξ), hξ_trim (h_rn ν hνξ),
      ae_of_ae_map (comap_measurable g).aemeasurable h_div] with x h1 h2 h3 h4
  rw [h1, h2, h3, h4]

/-- The Radon-Nikodym derivative `∂(μ.map g)/∂(ν.map g)` evaluated at `g x` is `ν`-a.e. equal to
the Radon-Nikodym derivative of the restrictions of `μ` and `ν` to the σ-algebra `m𝓨.comap g`. -/
lemma rnDeriv_map_comp_ae_eq_rnDeriv_trim [SigmaFinite (μ.map g)] [SigmaFinite (ν.map g)]
    (hg : Measurable g) :
    (fun x ↦ (μ.map g).rnDeriv (ν.map g) (g x))
      =ᵐ[ν] (μ.trim hg.comap_le).rnDeriv (ν.trim hg.comap_le) :=
  (ae_eq_of_ae_eq_trim (rnDeriv_trim_comap_ae_eq hg)).symm

end MeasureTheory
