module

public import Mathlib.MeasureTheory.Function.ConditionalLExpectation
public import Statlib.ForMathlib.MeasureTheory.Measure.Trim

/-!
# Conditional Lebesgue expectation with respect to a countable partition

For a measurable map `g : α → β` to a countable space with measurable singletons, the
sigma-algebra `mβ.comap g` is generated by the countable partition `{g ⁻¹' {b}}`. The conditional
Lebesgue expectation with respect to it is the average over the cell containing the point.

## Main statements

* `MeasureTheory.ae_measure_preimage_singleton_ne_zero`: almost every point lies in a cell of
  positive measure.
* `MeasureTheory.condLExp_comap_ae_eq`: `P⁻[X | mβ.comap g] x` is the average of `X` over the cell
  `g ⁻¹' {g x}`, for `P`-almost every `x`.
-/

@[expose] public section

open Set MeasureTheory

open scoped ENNReal

namespace MeasureTheory

variable {α β : Type*} {mα : MeasurableSpace α} {mβ : MeasurableSpace β}
  [Countable β] {g : α → β} {P : Measure α}

/-- Almost every point lies in a cell `g ⁻¹' {g x}` of positive measure. -/
lemma ae_measure_preimage_singleton_ne_zero :
    ∀ᵐ x ∂P, P (g ⁻¹' {g x}) ≠ 0 := by
  have h_null : P (⋃ b ∈ {b | P (g ⁻¹' {b}) = 0}, g ⁻¹' {b}) = 0 :=
    (measure_biUnion_null_iff (to_countable _)).2 fun b hb ↦ hb
  refine measure_mono_null (fun x hx ↦ ?_) h_null
  simp only [mem_iUnion, mem_preimage, mem_singleton_iff, exists_prop]
  exact ⟨g x, not_not.mp hx, rfl⟩

/-- The conditional Lebesgue expectation with respect to the sigma-algebra induced by a map `g`
with countable codomain is the average over the cell `g ⁻¹' {g x}`.

The hypothesis that `P.map g` is σ-finite means that all the cells have finite measure. -/
theorem condLExp_comap_ae_eq [MeasurableSingletonClass β] [SigmaFinite (P.map g)]
    (hg : Measurable g) (X : α → ℝ≥0∞) :
    P⁻[X | mβ.comap g] =ᵐ[P] fun x ↦ (∫⁻ y in g ⁻¹' {g x}, X y ∂P) / P (g ⁻¹' {g x}) := by
  have := sigmaFinite_trim_comap (μ := P) hg
  set c : β → ℝ≥0∞ := fun b ↦ (∫⁻ y in g ⁻¹' {b}, X y ∂P) / P (g ⁻¹' {b})
  have h_cell (b : β) : ∫⁻ x in g ⁻¹' {b}, c (g x) ∂P = ∫⁻ x in g ⁻¹' {b}, X x ∂P := by
    have hb : MeasurableSet (g ⁻¹' {b}) := hg (measurableSet_singleton b)
    rw [setLIntegral_congr_fun hb (g := fun _ ↦ c b) fun x hx ↦ by rw [hx], setLIntegral_const]
    rcases eq_or_ne (P (g ⁻¹' {b})) 0 with h0 | h0
    · rw [h0, mul_zero, setLIntegral_measure_zero _ _ h0]
    · refine ENNReal.div_mul_cancel h0 ?_
      rw [← Measure.map_apply hg (measurableSet_singleton b)]
      exact measure_singleton_lt_top.ne
  refine (ae_eq_condLExp hg.comap_le P X ((measurable_of_countable c).comp (comap_measurable g))
    fun s hs ↦ ?_).symm
  obtain ⟨t, -, rfl⟩ := hs
  have h_disj : t.PairwiseDisjoint fun b ↦ g ⁻¹' {b} :=
    fun a _ b _ hab ↦ (disjoint_singleton.2 hab).preimage g
  have h_meas : ∀ b ∈ t, MeasurableSet (g ⁻¹' {b}) := fun b _ ↦ hg (measurableSet_singleton b)
  rw [← biUnion_preimage_singleton, lintegral_biUnion (to_countable t) h_meas h_disj,
    lintegral_biUnion (to_countable t) h_meas h_disj]
  simp_rw [Function.comp_apply, h_cell]

end MeasureTheory
