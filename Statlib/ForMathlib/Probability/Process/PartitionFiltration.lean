module

public import Mathlib.Probability.Process.PartitionFiltration

/-!
# Finiteness of the σ-algebras of partition filtrations

## Main statements

* `ProbabilityTheory.finite_setOf_measurableSet_partitionFiltration`: the σ-algebras of the
  filtration `partitionFiltration ht` generated by the partitions `memPartition t n` have finitely
  many measurable sets.
* `ProbabilityTheory.finite_setOf_measurableSet_countableFiltration`: the same for the filtration
  `countableFiltration α` of a countably generated measurable space.
-/

@[expose] public section

open MeasureTheory MeasurableSpace

namespace ProbabilityTheory

variable {α : Type*} {mα : MeasurableSpace α}

/-- The σ-algebras of the filtration `partitionFiltration ht` have finitely many measurable sets. -/
lemma finite_setOf_measurableSet_partitionFiltration {t : ℕ → Set α}
    (ht : ∀ n, MeasurableSet (t n)) (n : ℕ) :
    {s | MeasurableSet[partitionFiltration ht n] s}.Finite := by
  refine ((finite_memPartition t n).finite_subsets.image fun S ↦ ⋃₀ S).subset fun s hs ↦ ?_
  obtain ⟨S, hS, rfl⟩ := (measurableSet_generateFrom_memPartition_iff t n s).1 hs
  exact ⟨S, hS, rfl⟩

/-- The σ-algebras of the filtration `countableFiltration α` have finitely many measurable sets. -/
lemma finite_setOf_measurableSet_countableFiltration [CountablyGenerated α] (n : ℕ) :
    {s | MeasurableSet[countableFiltration α n] s}.Finite :=
  finite_setOf_measurableSet_partitionFiltration
    (measurableSet_enumerateCountable_countableGeneratingSet α) n

end ProbabilityTheory
